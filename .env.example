# Copy to .env, then fill in locally. Never send these values in chat.
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# mock or production: selects the QUOTE server only. No broker orders exist.
KIWOOM_ENV=mock

# Cloud hosting: Node.js 24+, HTTPS origin, and a strong password (16+ chars).
# Render automatically supplies RENDER_EXTERNAL_URL; no PUBLIC_ORIGIN needed there.
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-domain.example
# DASHBOARD_PASSWORD=replace-with-a-long-random-password
